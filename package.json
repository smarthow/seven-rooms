{
  "name": "seven-rooms",
  "private": true,
  "version": "1.0.0",
  "description": "Seven Rooms — an experiment your agent runs on itself. A WebMCP-powered interactive explainer about what AI agents do to seven kinds of website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmartHow/seven-rooms.git"
  },
